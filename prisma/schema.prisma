generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  wallets         Wallet[]
  transactions    Transaction[]
  categories      Category[]
  receivables     Receivable[]
  liabilities     Liability[]
  properties      Property[]
  stocks          StockHolding[]
  commodities     CommodityHolding[]
  sideInvestments SideInvestment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── EXPENSE TRACKER ─────────────────────────────────────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // bank, cash, digital_wallet, other
  bankName  String?
  balance   Decimal  @db.Decimal(15, 2)
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  walletId    String
  categoryId  String?
  type        String   // inflow, outflow
  subType     String?  // earned_income, passive_income, receivable_collection, other_inflow, fixed_expense, variable_expense, lending, debt_repayment, savings_investment
  amount      Decimal  @db.Decimal(15, 2)
  description String?
  date        DateTime
  source      String   @default("manual") // manual, csv_import
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
}

model Category {
  id     String  @id @default(cuid())
  userId String
  name   String
  icon   String?
  color  String?
  type   String  // income, expense

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

// ─── RECEIVABLES ─────────────────────────────────────────────────────────────

model Receivable {
  id         String    @id @default(cuid())
  userId     String
  personName String
  amount     Decimal   @db.Decimal(15, 2)
  amountPaid Decimal   @db.Decimal(15, 2) @default(0)
  currency   String    @default("PKR")
  reason     String?
  status     String    @default("pending") // pending, partial, settled
  dueDate    DateTime?
  givenDate  DateTime
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments ReceivablePayment[]
}

model ReceivablePayment {
  id           String   @id @default(cuid())
  receivableId String
  amount       Decimal  @db.Decimal(15, 2)
  date         DateTime
  notes        String?

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
}

// ─── LIABILITIES ─────────────────────────────────────────────────────────────

model Liability {
  id         String    @id @default(cuid())
  userId     String
  personName String
  amount     Decimal   @db.Decimal(15, 2)
  amountPaid Decimal   @db.Decimal(15, 2) @default(0)
  currency   String    @default("PKR")
  reason     String?
  status     String    @default("pending") // pending, partial, settled
  dueDate    DateTime?
  takenDate  DateTime
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments LiabilityPayment[]
}

model LiabilityPayment {
  id          String   @id @default(cuid())
  liabilityId String
  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime
  notes       String?

  liability Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
}

// ─── INVESTMENTS — REAL ESTATE ───────────────────────────────────────────────

model Property {
  id           String    @id @default(cuid())
  userId       String
  name         String
  location     String?
  totalPrice   Decimal   @db.Decimal(15, 2)
  downPayment  Decimal   @db.Decimal(15, 2) @default(0)
  currentValue Decimal?  @db.Decimal(15, 2)
  status       String    @default("active") // active, sold, completed
  purchaseDate DateTime
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments Installment[]
}

model Installment {
  id          String    @id @default(cuid())
  propertyId  String
  amount      Decimal   @db.Decimal(15, 2)
  dueDate     DateTime
  paidDate    DateTime?
  status      String    @default("pending") // pending, paid, overdue
  receiptNote String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// ─── INVESTMENTS — STOCKS ────────────────────────────────────────────────────

model StockHolding {
  id           String   @id @default(cuid())
  userId       String
  symbol       String
  name         String
  quantity     Decimal  @db.Decimal(15, 4)
  avgBuyPrice  Decimal  @db.Decimal(15, 4)
  currentPrice Decimal? @db.Decimal(15, 4)
  currency     String   @default("PKR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades StockTrade[]
}

model StockTrade {
  id        String   @id @default(cuid())
  holdingId String
  type      String   // buy, sell
  quantity  Decimal  @db.Decimal(15, 4)
  price     Decimal  @db.Decimal(15, 4)
  fee       Decimal  @db.Decimal(15, 2) @default(0)
  date      DateTime
  notes     String?

  holding StockHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
}

// ─── INVESTMENTS — COMMODITIES ───────────────────────────────────────────────

model CommodityHolding {
  id           String   @id @default(cuid())
  userId       String
  type         String   // gold, silver, oil, etc.
  unit         String   // oz, gram, tola, barrel
  quantity     Decimal  @db.Decimal(15, 4)
  avgBuyPrice  Decimal  @db.Decimal(15, 4)
  currentPrice Decimal? @db.Decimal(15, 4)
  currency     String   @default("PKR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades CommodityTrade[]
}

model CommodityTrade {
  id        String   @id @default(cuid())
  holdingId String
  type      String   // buy, sell
  quantity  Decimal  @db.Decimal(15, 4)
  price     Decimal  @db.Decimal(15, 4)
  date      DateTime
  notes     String?

  holding CommodityHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
}

// ─── INVESTMENTS — OTHER / SIDE ──────────────────────────────────────────────

model SideInvestment {
  id             String    @id @default(cuid())
  userId         String
  name           String
  type           String    // crypto, lending, business, other
  investedAmount Decimal   @db.Decimal(15, 2)
  currentValue   Decimal   @db.Decimal(15, 2)
  currency       String    @default("PKR")
  status         String    @default("active") // active, closed, matured
  startDate      DateTime
  endDate        DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
