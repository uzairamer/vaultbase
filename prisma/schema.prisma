generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  wallets         Wallet[]
  transactions    Transaction[]
  categories      Category[]
  receivables     Receivable[]
  liabilities     Liability[]
  properties      Property[]
  stocks          StockHolding[]
  commodities     CommodityHolding[]
  sideInvestments SideInvestment[]
  watchlist       WatchlistItem[]
  segments        WalletSegment[]
  incomeSources   IncomeSource[]
  incomeBreakdown IncomeBreakdown[]
  staticPrices    StaticPrice[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── EXPENSE TRACKER ─────────────────────────────────────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // bank, cash, digital_wallet, other
  bankName  String?
  balance   Decimal  @db.Decimal(15, 2)
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  segments     WalletSegment[]
}

model WalletSegment {
  id              String    @id @default(cuid())
  userId          String
  walletId        String
  name            String
  amount          Decimal   @db.Decimal(15, 2) @default(0)
  color           String    @default("#6366f1")
  isDefault       Boolean   @default(false)
  resetSchedule   String    @default("none") // none | weekly | monthly | quarterly
  resetAmount     Decimal?  @db.Decimal(15, 2) // amount to reset to (null = reset to 0)
  lastResetAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  walletId    String
  categoryId  String?
  type        String   // inflow, outflow
  subType     String?  // earned_income, passive_income, receivable_collection, other_inflow, fixed_expense, variable_expense, lending, debt_repayment, savings_investment
  amount      Decimal  @db.Decimal(15, 2)
  description String?
  date        DateTime
  source      String   @default("manual") // manual, csv_import
  archivedAt  DateTime?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
}

model Category {
  id     String  @id @default(cuid())
  userId String
  name   String
  icon   String?
  color  String?
  type   String  // income, expense

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

// ─── RECEIVABLES ─────────────────────────────────────────────────────────────

model Receivable {
  id         String    @id @default(cuid())
  userId     String
  personName String
  amount     Decimal   @db.Decimal(15, 2)
  amountPaid Decimal   @db.Decimal(15, 2) @default(0)
  currency   String    @default("PKR")
  reason     String?
  status     String    @default("pending") // pending, partial, settled
  dueDate    DateTime?
  givenDate  DateTime
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments ReceivablePayment[]
}

model ReceivablePayment {
  id           String   @id @default(cuid())
  receivableId String
  amount       Decimal  @db.Decimal(15, 2)
  date         DateTime
  notes        String?

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
}

// ─── LIABILITIES ─────────────────────────────────────────────────────────────

model Liability {
  id         String    @id @default(cuid())
  userId     String
  personName String
  amount     Decimal   @db.Decimal(15, 2)
  amountPaid Decimal   @db.Decimal(15, 2) @default(0)
  currency   String    @default("PKR")
  reason     String?
  status     String    @default("pending") // pending, partial, settled
  dueDate    DateTime?
  takenDate  DateTime
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments LiabilityPayment[]
}

model LiabilityPayment {
  id          String   @id @default(cuid())
  liabilityId String
  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime
  notes       String?

  liability Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
}

// ─── INVESTMENTS — REAL ESTATE ───────────────────────────────────────────────

model Property {
  id                   String    @id @default(cuid())
  userId               String
  name                 String
  location             String?
  totalPrice           Decimal   @db.Decimal(15, 2)
  downPayment          Decimal   @db.Decimal(15, 2) @default(0)
  monthlyInstallment   Decimal?  @db.Decimal(15, 2)
  balloonAmount        Decimal?  @db.Decimal(15, 2)
  balloonEveryNMonths  Int?
  installmentStartDate DateTime?
  installmentDueDay    Int?      // 1-31, day of month
  installmentMonths    Int?      // total tenure in months
  currentValue         Decimal?  @db.Decimal(15, 2)
  status               String    @default("active") // active, sold, completed
  purchaseDate         DateTime
  notes                String?
  archivedAt           DateTime?
  ledgerLocked         Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments Installment[]
}

model Installment {
  id          String    @id @default(cuid())
  propertyId  String
  type        String    @default("regular") // regular | balloon
  amount      Decimal   @db.Decimal(15, 2)
  dueDate     DateTime
  paidDate    DateTime?
  status      String    @default("pending") // pending | paid | unpaid
  receiptNote String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// ─── WATCHLIST ──────────────────────────────────────────────────────────────

model WatchlistItem {
  id      String   @id @default(cuid())
  userId  String
  symbol  String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// ─── INVESTMENTS — STOCKS ────────────────────────────────────────────────────

model StockHolding {
  id           String    @id @default(cuid())
  userId       String
  symbol       String
  name         String
  quantity     Decimal   @db.Decimal(15, 4)
  avgBuyPrice  Decimal   @db.Decimal(15, 4)
  currentPrice Decimal?  @db.Decimal(15, 4)
  purchaseDate DateTime  @default(now())
  currency     String    @default("PKR")
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades StockTrade[]
}

model StockTrade {
  id        String   @id @default(cuid())
  holdingId String
  type      String   // buy, sell
  quantity  Decimal  @db.Decimal(15, 4)
  price     Decimal  @db.Decimal(15, 4)
  fee       Decimal  @db.Decimal(15, 2) @default(0)
  date      DateTime
  notes     String?

  holding StockHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
}

// ─── INVESTMENTS — COMMODITIES ───────────────────────────────────────────────

model CommodityHolding {
  id             String    @id @default(cuid())
  userId         String
  type           String    // gold, silver, oil, etc.
  unit           String    // oz, gram, tola, barrel
  quantity       Decimal   @db.Decimal(15, 4)
  avgBuyPrice    Decimal   @db.Decimal(15, 4)  // derived: totalCostPaid / quantity
  totalCostPaid  Decimal?  @db.Decimal(15, 2)  // actual amount paid incl. tax & charges
  currentPrice   Decimal?  @db.Decimal(15, 4)
  staticPriceId  String?
  currency       String    @default("PKR")
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades       CommodityTrade[]
  staticPrice  StaticPrice?     @relation(fields: [staticPriceId], references: [id], onDelete: SetNull)
}

// ─── STATIC PRICES ───────────────────────────────────────────────────────────

model StaticPrice {
  id        String             @id @default(cuid())
  userId    String
  name      String             // e.g. "Gold", "Silver"
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   StaticPriceEntry[]
  holdings  CommodityHolding[]

  @@unique([userId, name])
}

model StaticPriceEntry {
  id            String      @id @default(cuid())
  staticPriceId String
  pricePerTola  Decimal     @db.Decimal(15, 4)
  date          DateTime
  note          String?
  createdAt     DateTime    @default(now())

  staticPrice   StaticPrice @relation(fields: [staticPriceId], references: [id], onDelete: Cascade)
}

model CommodityTrade {
  id        String   @id @default(cuid())
  holdingId String
  type      String   // buy, sell
  quantity  Decimal  @db.Decimal(15, 4)
  price     Decimal  @db.Decimal(15, 4)
  date      DateTime
  notes     String?

  holding CommodityHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
}

// ─── INVESTMENTS — OTHER / SIDE ──────────────────────────────────────────────

model SideInvestment {
  id             String    @id @default(cuid())
  userId         String
  name           String
  type           String    // crypto, lending, business, other
  investedAmount Decimal   @db.Decimal(15, 2)
  currentValue   Decimal   @db.Decimal(15, 2)
  currency       String    @default("PKR")
  status         String    @default("active") // active, closed, matured
  startDate      DateTime
  endDate        DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── INCOME BREAKDOWN ────────────────────────────────────────────────────────

model IncomeSource {
  id          String   @id @default(cuid())
  userId      String
  name        String
  amount      Decimal  @db.Decimal(15, 2)
  currency    String   @default("PKR")
  color       String   @default("#6366f1")
  frequency   String   @default("monthly") // daily, weekly, monthly, quarterly, annually
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  breakdown IncomeBreakdown[]
}

model IncomeBreakdown {
  id             String   @id @default(cuid())
  userId         String
  incomeSourceId String
  parentId       String?
  name           String
  amount         Decimal  @db.Decimal(15, 2)
  color          String   @default("#6366f1")
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeSource IncomeSource      @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)
  parent       IncomeBreakdown?  @relation("BreakdownChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     IncomeBreakdown[] @relation("BreakdownChildren")
}
